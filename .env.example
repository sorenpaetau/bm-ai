# Copy to .env.local for local dev.
DATABASE_URL=postgres://bm:bm@localhost:5432/bm
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Needed for AI landing page drafts (portal). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Card payments (Stripe). Use a test key (sk_test_...) until B&M.ai is ready for real money.
# On Vercel production deploys the webhook is registered automatically; for local testing run
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` and put its whsec_... below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: email B&M.ai staff when a tag order is paid (https://resend.com). Comma-separate addresses.
RESEND_API_KEY=
ORDER_ALERT_EMAIL=
